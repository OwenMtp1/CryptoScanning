{
  "name": "crypto-radar",
  "private": true,
  "version": "0.1.0",
  "description": "Coinbase Autonomous Trading Radar — local-first (phase 1: radar only)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @radar/server --filter @radar/dashboard dev",
    "dev:server": "pnpm --filter @radar/server dev",
    "dev:dashboard": "pnpm --filter @radar/dashboard dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @radar/dashboard build"
  }
}
