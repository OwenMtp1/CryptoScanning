# ─────────────────────────────────────────────────────────────────────────────
# Crypto Radar — configuration locale (copier en `.env`, jamais committé)
# Phase 1 : RADAR uniquement, données publiques. AUCUNE clé API n'est requise.
# ─────────────────────────────────────────────────────────────────────────────

# Mode : seul RADAR est implémenté. PAPER / LIVE sont refusés au démarrage.
MODE=RADAR

# Source des données : "simulated" (fictives) ou "coinbase" (API publique réelle)
DATA_SOURCE=simulated

# API locale (ne pas exposer sur le réseau : 127.0.0.1 uniquement)
HOST=127.0.0.1
PORT=4000
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Univers de produits (récupéré dynamiquement, puis filtré)
QUOTE_CURRENCIES=EUR,USDC
MAX_PRODUCTS=100

# Coinbase (données publiques, sans authentification)
COINBASE_REST_BASE_URL=https://api.coinbase.com/api/v3/brokerage
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
COINBASE_REST_MAX_RPS=3
WS_PRODUCTS_PER_CONNECTION=25
WS_MAX_SUBSCRIBE_MSG_PER_SEC=4

# Moteur
EVAL_INTERVAL_MS=1000
SIGNAL_CONFIG_FILE=config/signal-config.json
LOG_DIR=data/logs

# Simulateur
SIM_SEED=42
SIM_TICK_MS=250

# Dashboard : Next.js lit apps/dashboard/.env.local (pas ce fichier).
# Par défaut il contacte http://127.0.0.1:4000 ; pour changer :
#   echo NEXT_PUBLIC_API_URL=http://127.0.0.1:4000 > apps/dashboard/.env.local

# Les clés Coinbase (phases ultérieures) seront ajoutées ici, côté serveur
# uniquement, avec les permissions minimales (View + Trade, JAMAIS Transfer).
